local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Создаём интерфейс
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DemoGUI"
screenGui.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 150)
frame.Position = UDim2.new(0.5, -100, 0.5, -75)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
frame.BorderSizePixel = 0

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Position = UDim2.new(0, 0, 0, 0)
title.Text = "Демо GUI"
title.TextColor3 = Color3.white
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 16

local btnFogOn = Instance.new("TextButton")
btnFogOn.Size = UDim2.new(1, -20, 0, 40)
btnFogOn.Position = UDim2.new(0, 10, 0, 40)
btnFogOn.Text = "Включить туман"
btnFogOn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
btnFogOn.TextColor3 = Color3.white

local btnFogOff = Instance.new("TextButton")
btnFogOff.Size = UDim2.new(1, -20, 0, 40)
btnFogOff.Position = UDim2.new(0, 10, 0, 90)
btnFogOff.Text = "Убрать туман"
btnFogOff.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
btnFogOff.TextColor3 = Color3.white

-- Собираем элементы
title.Parent = frame
btnFogOn.Parent = frame
btnFogOff.Parent = frame
frame.Parent = screenGui
screenGui.Parent = playerGui

-- Управление туманом (легально, через Lighting)
local lighting = game:GetService("Lighting")

btnFogOn.MouseButton1Click:Connect(function()
	lighting.FogStart = 0
	lighting.FogEnd = 1000
	lighting.FogColor = Color3.new(0.8, 0.8, 0.9)
end)

btnFogOff.MouseButton1Click:Connect(function()
	lighting.FogStart = 0
	lighting.FogEnd = 99999
	lighting.FogColor = lighting.OutdoorAmbient -- возвращаем естественный цвет
end)
